<Window x:Name="MyWindow" x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Break_Out_MFA"
        mc:Ignorable="d"
        Title="Ghostly Tower" Height="800" Width="400">

	<Window.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#2A0000" Offset="0.0"/>
			<GradientStop Color="#5A0000" Offset="0.5"/>
			<GradientStop Color="#8A0000" Offset="1.0"/>
		</LinearGradientBrush>
	</Window.Background>

	<Canvas Name="MainCanvas" Height="800" Width="400">

	</Canvas>
</Window>